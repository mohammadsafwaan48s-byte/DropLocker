{
  "name": "droplocker",
  "version": "1.0.0",
  "description": "Lightweight, zero-cost, bi-directional cross-device file transfer hub",
  "main": "src/worker.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init:local": "wrangler d1 execute droplocker-db --local --file=./migrations/0001_create_files.sql",
    "db:init:remote": "wrangler d1 execute droplocker-db --remote --file=./migrations/0001_create_files.sql",
    "generate-icons": "node scripts/generate-icons.js",
    "desktop:install": "cd desktop && npm install",
    "desktop": "cd desktop && npx electron ."
  },
  "keywords": ["cloudflare", "workers", "r2", "d1", "pwa", "file-sharing"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "wrangler": "^3.78.10"
  }
}
